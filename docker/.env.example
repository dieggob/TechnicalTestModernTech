# Variables for docker/docker-compose.yml. Copy to docker/.env (git-ignored); scripts/compose-up.sh
# does that and generates the signing key. Values in the shell environment override this file.
# Names of API settings are the same as in apps/api-maintenance/.env.example.

# Host ports. The client is at http://localhost:${WEB_PORT}; the API is also reachable directly at
# http://localhost:${API_PORT} (the client reaches it through Nginx's /api proxy).
API_PORT=5000
WEB_PORT=4200

# Secret of at least 32 characters used to sign session tokens. Generated by scripts/compose-up.sh.
Jwt__SigningKey=

# Production hides Swagger and the Development-only /api/v1/dev/emails endpoint the Playwright
# suite reads emailed links from. Set Development to run the suite against the stack.
ASPNETCORE_ENVIRONMENT=Production

# Feature flag: when true, every endpoint outside /auth answers 403 EmailNotVerified for unverified accounts.
Auth__RequireEmailVerification=false

# Login, resend-verification, and forgot-password attempts allowed per client address per minute.
# Behind Nginx every browser shares the proxy's address; raise it (1000) for the Playwright suite.
RateLimits__AuthPermitLimit=10

# PrimeUI license key for PrimeNG 22, embedded in the client image at build time (free Community
# license for individuals at https://primeui.dev). Empty keeps the "Invalid PrimeUI License" badge.
PRIMEUI_LICENSE=
