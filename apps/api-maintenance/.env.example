# Environment variables read by the API (ASP.NET Core maps A__B to A:B). Copy to .env for
# docker compose; for `dotnet run` use appsettings.Development.json or `dotnet user-secrets`.
# Real .env files are git-ignored.

# SQLite database file; relative paths resolve from the API's working directory.
ConnectionStrings__Default=Data Source=maintenance.db

# Lifetime of emailed verification and password-reset links (hh:mm:ss). Product decision: 30 minutes.
Tokens__Lifetime=00:30:00

# Public URL of the web client, embedded in emailed links.
Client__BaseUrl=http://localhost:4200

# Session tokens. The signing key is a secret of at least 32 characters; locally it lives in
# `dotnet user-secrets` (scripts/setup.sh generates one), under compose in docker/.env.
Jwt__SigningKey=
Jwt__Lifetime=24:00:00

# Login, resend-verification, and forgot-password attempts allowed per client address per window.
RateLimits__AuthPermitLimit=10
RateLimits__AuthWindow=00:01:00
