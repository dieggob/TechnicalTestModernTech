{
  "ConnectionStrings": {
    "Default": "Data Source=maintenance.db"
  },
  "Tokens": {
    "Lifetime": "00:30:00"
  },
  "Client": {
    "BaseUrl": "http://localhost:4200"
  },
  "Jwt": {
    "Issuer": "maintenance-api",
    "Audience": "maintenance-client",
    "Lifetime": "24:00:00"
  },
  "Auth": {
    "RequireEmailVerification": false
  },
  "Cors": {
    "ClientOrigin": "http://localhost:4200"
  },
  "RateLimits": {
    "AuthPermitLimit": 10,
    "AuthWindow": "00:01:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
