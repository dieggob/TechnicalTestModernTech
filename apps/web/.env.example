# Copy to .env (git-ignored). Build-time values the repository scripts pass to ng serve / ng build.

# PrimeUI license key for PrimeNG 22 (free Community license for individuals at https://primeui.dev).
# Without it the app works but shows an "Invalid PrimeUI License" badge. The key is embedded in the
# built bundle by design; keep it out of the repository anyway. For the compose stack put it in docker/.env.
PRIMEUI_LICENSE=
